# Required for durable production persistence
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
FORGE_PERSISTENCE_KEY=forge-production-v17

# Native Android WebView origin; add custom web origins only if needed.
FORGE_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost

# API-only production runtime
FORGE_SERVE_FRONTEND=0
FORGE_DB_PATH=/tmp/forge/fitness_app.sqlite
FORGE_DB_SEED_PATH=/app/fitness_app_initial_database.sqlite

# AI Coach
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FORGE_LLM_MODEL=gpt-5.6-luna
FORGE_LLM_ENABLED=1
FORGE_LLM_TIMEOUT=25

# Google Calendar OAuth, if configured by calendar_integration.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
